# Committed placeholder defaults only. Real values are delivered by the platform to
# /run/base44/app.env, which compose loads AFTER this file, so a dashboard secret always wins.
# Every value here is deliberately empty/non-functional: an empty value switches the
# integration off and the app falls back to its built-in stub.
SESSION_SECRET=localloop-dev-only-session-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MAPBOX_TOKEN=
AI_API_KEY=
# Bitcoin checkout. With a BTCPay Server store the app opens real invoices; without one it
# issues sandbox invoices that only this environment can settle. An empty rate falls back to
# the built-in reference rate in api/src/lib/bitcoin.ts.
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
BITCOIN_USD_RATE=
